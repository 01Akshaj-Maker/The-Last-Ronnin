[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_variant.gd" id="3"]

[sub_resource type="Resource" id="variant_spared"]
script = ExtResource("3")
axis = "Mercy"
comparator = ">="
threshold = 2
body = "You came up from the rainy village? Then you'll have heard of the rice-thief who kept his hand. Word is a samurai spared him. He passed through three days back, bound north, swearing he'd steal no more. Small mercies travel farther than the men who give them."

[sub_resource type="Resource" id="variant_killed"]
script = ExtResource("3")
axis = "Mercy"
comparator = "<="
threshold = -1
body = "You came up from the rainy village? Then maybe you passed what's left of the rice-thief. They took his hand for a fistful of rice — and a one-handed man can't work. They found him in a ditch a mile north, cold as the law that killed him."

[resource]
script = ExtResource("1")
speaker = "Beggar Beneath the Bamboo"
body = "Spare a coin? No — you've nothing to spare but distance. We're alike, then, you and I. The road uses us both and thanks neither."
variants = [SubResource("variant_spared"), SubResource("variant_killed")]
choices = []
