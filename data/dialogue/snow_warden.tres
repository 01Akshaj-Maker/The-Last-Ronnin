[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_variant.gd" id="3"]

[sub_resource type="Resource" id="variant_merciful"]
script = ExtResource("3")
axis = "Mercy"
comparator = ">="
threshold = 3
body = "The wind carries word, even this high. They say a gentleness came down with you — a blade stayed at a crossroads, a grief you would not leave alone. Small kindnesses, from a man with a sword. The dead remember kindness longer than the living do, samurai. You would know that, perhaps, better than you think."

[sub_resource type="Resource" id="variant_hard"]
script = ExtResource("3")
axis = "Mercy"
comparator = "<="
threshold = -1
body = "The wind carries word, even this high. They say a hardness came down with you — the old law kept to its cruel letter, a griever left alone. Cold, the road names you. Cold as this pass. Did you truly never wonder why the snow does not trouble you?"

[resource]
script = ExtResource("1")
speaker = "Warden of the Pass"
body = "Few climb this high. Fewer still who are... all the way here. The wind pares a man down to what he truly is — and you press no more weight into the snow than a cold thought does. When did you last feel the cold, samurai? Or need to eat, or sleep, or bleed? No — don't answer. Some doors are kinder left closed a while longer."
variants = [SubResource("variant_merciful"), SubResource("variant_hard")]
choices = []
