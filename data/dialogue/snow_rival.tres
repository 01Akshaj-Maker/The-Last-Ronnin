[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_mercy"]
script = ExtResource("2")
text = "Kneel, and give an old enemy the clean death a warrior is owed."
effects = {
"Honor": 3,
"Mercy": 2
}
reply = "You kneel. The stroke is quick and clean — kinder than the war ever was. His breath leaves him like a man setting down a weight carried too far. He dies an enemy no longer — only a soldier, gone home a little ahead of you."

[sub_resource type="Resource" id="choice_cold"]
script = ExtResource("2")
text = "Let the war have its last word. Turn, and leave him to the slow cold."
effects = {
"Attachment": 3,
"Mercy": -2
}
reply = "You turn your back. Behind you the breathing goes on a while, then thins, then stops. The snow falls on you both the same. The war has its last word — and it sounds like nothing at all."

[resource]
script = ExtResource("1")
speaker = "A Fallen Enemy"
body = "You know this face — older, greyer, half-buried in snow, but you know it, from the wrong end of a hundred spears. He is broken beyond saving, and the cold is taking him slow. His eyes find you, almost glad. \"So. They sent you, of all the ghosts. Finish it, old enemy — or don't. At the end, I find I no longer care which.\""
variants = []
choices = [SubResource("choice_mercy"), SubResource("choice_cold")]
