[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
speaker = "Higher Cairn"
body = "Another cairn, higher up, half-lost in the drift. Whoever stacked it climbed no further. You wonder if they turned back — or if this was simply as far as they were ever meant to go."
variants = []
choices = []
