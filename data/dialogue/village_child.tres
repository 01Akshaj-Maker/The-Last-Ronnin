[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2")
text = "Run home, child. The rain will chill you to the bone."
effects = {
"Selflessness": 1,
"Attachment": -1
}
reply = "She backs a few steps toward the houses, then stops and looks at you over her shoulder. \"...You won't be here when I get home. Will you.\" It isn't quite a question. She turns and runs."

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2")
text = "Stay. Tell me what your grandmother sees."
effects = {
"Attachment": 2
}
reply = "She leans in, whispering it like a secret too big for her. \"She says there's a light that walks in front of you — not behind, the way a shadow should. Like something's already waiting where you're going.\" Then she steps back, suddenly shy. \"...I have to go now. Bye, mister.\""

[resource]
script = ExtResource("1")
speaker = "Child in the Rain"
body = "Mister… the rain is falling right through you. It isn't landing on you at all. Grandma says people like you are already partway to somewhere else, and I shouldn't talk to you for too long."
choices = [SubResource("choice_a"), SubResource("choice_b")]
