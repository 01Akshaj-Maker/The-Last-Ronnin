[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2")
text = "That I did my duty, whatever it cost me."
effects = {
"Honor": 2,
"Mercy": -1,
"Selflessness": 1
}
reply = "The old monk regards you a long moment. \"Duty is a clean word we tie to heavy things. Mind it does not become the only thing they can carve of you.\" He bows, and says no more."

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2")
text = "That I was gentler than the war left me."
effects = {
"Attachment": -1,
"Mercy": 2
}
reply = "A faint, sad smile creases his face. \"Gentleness, from a hand the war trained to kill — that is the harder discipline by far. Walk on, samurai. Your road is very nearly walked.\""

[resource]
script = ExtResource("1")
speaker = "Wandering Monk"
body = "You carry a message you cannot read, samurai — to a place you have never been, yet your feet already know the way. When the road finally ends, what would you have it say of the man who walked it?"
choices = [SubResource("choice_a"), SubResource("choice_b")]
