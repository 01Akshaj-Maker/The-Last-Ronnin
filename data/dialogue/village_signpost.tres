[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
speaker = "Weathered Signpost"
body = "Most of the writing has worn away to nothing. Only one mark is left — an arrow, pointing north, to the road out of the valley and up toward the mountains. Somehow, your feet already want to follow it. And unbidden, like a voice at your shoulder, the vow surfaces again: Carry it to the end. Do not set it down."
variants = []
choices = []
