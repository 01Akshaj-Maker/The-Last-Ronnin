[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
speaker = "Trail Cairn"
body = "A cairn of stacked stones, half-drowned in a drift — left by pilgrims who climbed here long before the war. It points the way on: more snow, more wind, more up. Someone once believed this road led somewhere worth the climb. Up here, you find you have to believe it too."
variants = []
