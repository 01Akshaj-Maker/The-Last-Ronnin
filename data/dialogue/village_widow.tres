[gd_resource type="Resource" script_class="DialogueData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_choice.gd" id="2"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_variant.gd" id="3"]

[sub_resource type="Resource" id="variant_mercy"]
script = ExtResource("3")
axis = "Mercy"
comparator = ">="
threshold = 2
body = "The rice-thief still has both his hands — and his children ate tonight, first time in days. They say that mercy was yours, stranger. Bless you for it. Kindness has grown so rare in this war I had near forgotten its face."

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2")
text = "The moment asked, and I answered it."
effects = {
"Honor": 1
}

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2")
text = "No child should starve over a fistful of rice."
effects = {
"Mercy": 1,
"Selflessness": 1
}

[resource]
script = ExtResource("1")
speaker = "Widow by the Shrine"
body = "They took the rice-thief's hand at the crossroads this morning — I hear you gave him to the magistrate without a flicker. Well. The law is fed, at least. Hard times make hard men, I suppose."
variants = [SubResource("variant_mercy")]
choices = [SubResource("choice_a"), SubResource("choice_b")]
