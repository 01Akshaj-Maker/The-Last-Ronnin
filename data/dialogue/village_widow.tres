[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/dialogue_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_a"]
script = ExtResource("2")
text = "The dead are owed silence, not talk."
effects = {
"Honor": 1,
"Mercy": -1
}

[sub_resource type="Resource" id="choice_b"]
script = ExtResource("2")
text = "Say his name to me. I will carry it a while."
effects = {
"Mercy": 2,
"Selflessness": 1
}

[resource]
script = ExtResource("1")
speaker = "Widow by the Shrine"
body = "You have a soldier's walk — my son had it too, before the war swallowed him whole. Strange. You look at our little shrine as though you already know which stone is loose."
choices = [SubResource("choice_a"), SubResource("choice_b")]
