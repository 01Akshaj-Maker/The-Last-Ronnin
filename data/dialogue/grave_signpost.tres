[ext_resource type="Script" path="res://scripts/systems/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
speaker = "A message, cut into the post"
body = "I walked until the world fell silent,
carrying one forgotten name —
a vow to bring him home
and lay him down beneath it.
Carry it to the end, I told myself.
Do not set it down.
At the last hill I found the name cut in stone,
and knew at last whose it had always been.
I set the vow down there, kept,
and the wind remembered me.

Only one who truly knows will understand these words."
variants = []
