[gd_resource type="Resource" script_class="GameFlowData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/systems/game_flow_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/chapter_entry.gd" id="2"]

[sub_resource type="Resource" id="ch_village"]
script = ExtResource("2")
scene_path = "res://scenes/world/Main.tscn"
travel_text = "He walked on, and the rain thinned to mist. The road narrowed, the grey fields gave way to green — and the bamboo closed over him like water."

[sub_resource type="Resource" id="ch_bamboo"]
script = ExtResource("2")
scene_path = "res://scenes/world/BambooForest.tscn"
travel_text = "The bamboo fell away behind him, and the air went thin and white. The land tilted upward — stone, and then snow — toward the last cold shoulder of the mountains, where the world runs out of green and nearly out of sound."

[sub_resource type="Resource" id="ch_snow"]
script = ExtResource("2")
scene_path = "res://scenes/world/SnowMountain.tscn"
travel_text = "He crested the pass and started down its far side, into a great and final quiet. The wind let go of him. The road ran on, level and grey, toward the place the message had named — and he knew, now, that he was nearly there."

[resource]
script = ExtResource("1")
intro_scene = "res://scenes/flow/Intro.tscn"
intro_title = "The Last Ronin"
intro_body = "The great war is over. Your lord is dead, your clan scattered, your sword cracked at the hilt.

One duty is left to you: carry a final message across the land — though you cannot say who gave it to you, nor why.

Walk on, samurai. The road is waiting."
chapters = [SubResource("ch_village"), SubResource("ch_bamboo"), SubResource("ch_snow")]
ending_scene = "res://scenes/ending/Ending.tscn"
