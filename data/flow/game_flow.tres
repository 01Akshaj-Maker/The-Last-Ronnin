[sub_resource type="Resource" id="ch_village"]
script = ExtResource("2")
scene_path = "res://scenes/world/Main.tscn"
travel_text = "He walked on, and the rain thinned to mist. The grey fields gave way to green, and the bamboo closed over him like water."

[sub_resource type="Resource" id="ch_bamboo"]
script = ExtResource("2")
scene_path = "res://scenes/world/BambooForest.tscn"
travel_text = "The bamboo fell away behind him, and the air went thin and white. The land tilted upward — stone, then snow — toward the last cold shoulder of the mountains, where the world runs nearly out of sound."

