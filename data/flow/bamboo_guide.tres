[resource]
script = ExtResource("1")
onboarding = PackedStringArray("The rain is behind you now. Only bamboo, and the green hush between the stalks.", "A small sound threads the green quiet — a bell, ringing somewhere among the stalks. Something here is lost, and it is still calling.")
controls_hint = ""
