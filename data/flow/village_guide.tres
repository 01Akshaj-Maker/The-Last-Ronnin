[resource]
script = ExtResource("1")
onboarding = PackedStringArray("Another village the war has hollowed out. Strange — my feet knew the road here, though I have never walked it.", "Someone among them may know what message I carry. And why.")
controls_hint = "move — WASD / arrows           speak — E"
objectives = [SubResource("obj_talk"), SubResource("obj_leave")]
