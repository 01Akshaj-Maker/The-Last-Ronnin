[gd_resource type="Resource" script_class="GraveRecognition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/systems/grave_recognition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/recognition_line.gd" id="2"]

[sub_resource type="Resource" id="l1"]
script = ExtResource("2")
monk = false
text = "No... I only just arrived. How can it be mine—"

[sub_resource type="Resource" id="l2"]
script = ExtResource("2")
monk = true
text = "Be still, samurai. You are here now. That is enough."

[sub_resource type="Resource" id="l3"]
script = ExtResource("2")
monk = false
text = "...Yes. I remember it now."

[resource]
script = ExtResource("1")
lines = [SubResource("l1"), SubResource("l2"), SubResource("l3")]
line_fade = 1.2
line_hold = 2.2
settle = 1.8
