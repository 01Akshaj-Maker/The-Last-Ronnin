[gd_resource type="Resource" script_class="GraveReveal" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/grave_reveal.gd" id="1"]

[resource]
script = ExtResource("1")
lines = PackedStringArray("The road ends here. No village. No temple. No one waiting.", "Only a grave in the tall grass, its stone worn soft with years.", "You kneel to read the name. Your hand goes still.", "It is your own.", "You fell in the war, samurai. Long ago. The rain that never touched you, the road your feet already knew — not riddles. Only the world, walking you home.")
line_fade = 1.4
line_hold = 2.4
settle = 1.8
